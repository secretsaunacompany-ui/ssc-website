node_modules/
# package-lock.json is deliberately TRACKED (P-C): the deploy story rests on
# reproducible builds, so the lockfile is committed, not ignored.
.netlify/
.env
.env.*
.vscode/
.idea/
.DS_Store
*.log
dist/
.cache/
_site/

# MARVIN session-worktree metadata: local absolute paths and a session id,
# written by the worktree tooling. Never a build input; it was swept into a
# commit once by a `git add -A` (2026-08-06) and evicted here.
.marvin-worktree.json

# Visual diff harness working directory (builds, screenshots, asset cache)
.visual-diff/

# DOM-integrity working directory (builds, fingerprints, report)
.dom-integrity/

# Rhythm suite working directory (mutant dist copies)
.rhythm/
