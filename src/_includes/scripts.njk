    <!-- External JavaScript - Modular Architecture -->
    <!-- Load order matters: data & utils first, then components, then init last -->
    <script src="{{ '/js/data.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/utils.js' | assetUrl }}" defer></script>
    {# quote-store reads SSC.pricesVersion from data.js and is read by both
       navigation.js (the /contact/ fallback) and modal.js -- it must load after
       data.js and before either of them. #}
    <script src="{{ '/js/quote-store.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/animations.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/navigation.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/gallery.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/modal.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/compare.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/map.js' | assetUrl }}" defer></script>
    <script src="{{ '/js/forms.js' | assetUrl }}" defer></script>
{% if site.features.advisor %}
    <script src="{{ '/js/advisor.js' | assetUrl }}" defer></script>
{% endif %}
    <script src="{{ '/js/init.js' | assetUrl }}" defer></script>

    <!-- Analytics Tracker - Centralized via ssc-ops.netlify.app -->
    <script src="https://ssc-ops.netlify.app/tracker.js"
            data-site-id="ssc"
            data-endpoint="https://ssc-ops.netlify.app/.netlify/functions/track"
            defer></script>
