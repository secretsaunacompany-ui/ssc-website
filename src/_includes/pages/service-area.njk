    <div id="{{ area_id }}" class="page page--has-bg">
        <div class="page-bg--fixed page-bg--opacity-15" style="background-image: url('/img/{{ hero_image }}-1920w.webp');"></div>

        <section class="page-hero">
            <h1>{{ page_h1 }}</h1>
            <p>{{ page_subtitle }}</p>
        </section>

        <section class="container section--pt-6">
            <div class="grid-2 grid-2--responsive-gap">
                <div class="reveal">
                    {{ intro_content | safe }}
                </div>
                <div class="reveal">
                    <img loading="lazy" src="/img/{{ intro_image }}-1200w.webp" alt="{{ intro_image_alt }}" class="img--full-cover-500">
                </div>
            </div>
        </section>

        {% if features %}
        <section class="surface--elevated hero-overlay">
            <div class="hero-overlay__bg hero-overlay__bg--opacity-15" style="background-image: url('/img/{{ features_bg_image }}-1920w.webp');"></div>
            <div class="hero-overlay__content container">
                <h2 class="text-center reveal">{{ features_heading }}</h2>
                <div class="grid-3">
                    {% for feature in features %}
                    <div class="feature-block reveal">
                        <h3>{{ feature.title }}</h3>
                        <p class="measure-wide">{{ feature.description }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        {% if local_content %}
        <section class="container">
            <div class="reveal">
                {{ local_content | safe }}
            </div>
        </section>
        {% endif %}

        <section class="container text-center">
            <div class="pos-relative--z1 reveal">
                <h2>Ready to Build Your Sauna{{ " in " + area_name if area_name != "the Sea-to-Sky Corridor" else " in the Sea-to-Sky" }}?</h2>
                <p class="cta__text measure-wide">Every project starts with a conversation. Tell us about your space and we'll design something built to last.</p>
                <div class="cta__buttons">
                    <a href="/contact/" class="btn">Get a Quote</a>
                    <a href="/saunas/" class="btn btn-outline">View Our Saunas</a>
                </div>
            </div>
        </section>

        <section class="container">
            <div class="reveal">
                <h3>We Also Serve</h3>
                <p class="service-area-links">
                    {% for link in sibling_areas %}
                    <a href="{{ link.url }}" class="link--accent">{{ link.name }}</a>{% if not loop.last %} &middot; {% endif %}
                    {% endfor %}
                </p>
            </div>
        </section>
    </div>
