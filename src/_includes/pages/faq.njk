    <!-- Schema.org - FAQPage -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for item in faq.items %}
            {
                "@type": "Question",
                "name": "{{ item.question }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ item.schemaAnswer }}"
                }
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
    </script>

    <div id="faq" class="page page--has-bg">
        <div class="page-bg--fixed page-bg--opacity-10" style="background-image: url('https://res.cloudinary.com/dlhqdgmih/image/upload/q_auto,f_auto,w_1920/v1768271313/IMG_2819_bl3kb1.jpg');"></div>
        <section class="page-hero hero-overlay">
            <div class="hero-overlay__bg hero-overlay__bg--opacity-30" style="background-image: url('https://res.cloudinary.com/dlhqdgmih/image/upload/q_auto,f_auto,w_1920/v1768256595/IMG_3337_a48dbb.jpg');"></div>
            <div class="hero-overlay__content">
                <h1>Frequently Asked Questions</h1>
                <p>What you need to know about working with us</p>
            </div>
        </section>

        <section class="container section--tight">
{% if site.features.advisor %}
            <div class="advisor-container reveal"
                 data-advisor-type="faq"
                 data-advisor-placeholder="What do you want to know?"
                 data-advisor-multi-turn="false"
                 data-advisor-starters='["Can I put a sauna on a floating dock?","What electrical work do I need?","How does delivery work to Whistler?"]'>
            </div>
{% endif %}

            {% for item in faq.items %}
            {# C35. The question announced as a HEADING and did the work of a
               button: role="button" and tabindex were bolted on in JS, Space
               scrolled the page instead of toggling, and the accessible name
               and the control were the same node.

               A real <button> INSIDE the heading fixes both halves at once. The
               <h3> stays, because the FAQ page's document outline is real
               structure and the FAQPage schema above depends on the questions
               being headings; the button is what takes focus, announces its
               expanded state, and handles Enter and Space natively. #}
            <div class="faq-item reveal">
                <h3 class="faq-question-heading">
                    <button type="button" class="faq-question" aria-expanded="false" aria-controls="faq-answer-{{ loop.index }}">{{ item.question }}</button>
                </h3>
                <p class="faq-answer" id="faq-answer-{{ loop.index }}">{{ item.answer | safe }}</p>
            </div>
            {% endfor %}
        </section>
    </div>

