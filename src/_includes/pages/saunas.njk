        <section class="page-hero hero-overlay">
            <div class="hero-overlay__bg hero-overlay__bg--opacity-30" style="background-image: url('https://res.cloudinary.com/dlhqdgmih/image/upload/q_auto,f_auto,w_1920/v1768250656/IMG_7875-EDIT-EDIT_dbj20g.jpg');"></div>
            <div class="hero-overlay__content">
                <h1>Our Saunas</h1>
                <p>Standard models, custom builds, and mobile saunas</p>
            </div>
        </section>

        <!-- 2. THE MODEL INDEX (Jen Stage 0.7 §1) -- archetype E, tight tier.
             Five rule-separated rows replace the card grid: the page's new
             spine. No images in the rows; the plates carry the evidence, the
             ledger carries the facts. Each row is ONE actionable element
             carrying the data-action/data-model pair the configurator, the
             price-hash suite and the round-trip all click. -->
        <section id="models" class="container section--tight">
            <span class="eyebrow--wide reveal">Standard Builds</span>

            <div class="model-index">
                <!-- The column labels carry classes rather than nothing, and the
                     reason is an instrument one found by measuring: a whitelist
                     entry identifies a node by a `contains` substring of its
                     ATTRIBUTES, so an attribute-less <span> can never be named
                     by one. Five bare spans would be undeclarable by
                     construction -- the same gap delete-subtree exists to close
                     on the removal side. -->
                <div class="model-index__head" aria-hidden="false">
                    <span class="model-index__label model-index__label--thumb"></span>
                    <span class="model-index__label model-index__label--model">Model</span>
                    <span class="model-index__label model-index__label--size">Size</span>
                    <span class="model-index__label model-index__label--capacity">Capacity</span>
                    <span class="model-index__label model-index__label--price">Price</span>
                    <span class="model-index__label model-index__label--affordance"></span>
                </div>
{%- for key in models.order %}{% set m = models.models[key] %}
                <!-- NO aria-label, deliberately (Razor W2b). One read
                     "S4 — configure and request a quote", which SHADOWS the row:
                     an accessible name overrides the content it names, so a
                     screen-reader user in focus mode met five buttons that
                     differed only by designation and carried no price at all,
                     on the page whose whole job is prices. Without it the name
                     computes from the content and carries every fact the sighted
                     row carries, from the same gated data file. -->
                <div class="model-row reveal" role="button" tabindex="0" data-action="open-modal" data-model="{{ m.id }}">
                    <!-- alt="" deliberately, and for the same reason the row
                         carries no aria-label (Razor W2b): this <img> sits
                         INSIDE a role="button", so any alt text would join the
                         row's computed name and push the price further from the
                         front of it. The row already names the model in text;
                         the photograph is what the sighted reader gets and the
                         accessible name is left exactly as it was.
                         `sizes` is authored so the transform's candidate list
                         resolves to a thumbnail rather than the 800px default —
                         the same per-element override the hero uses.

                         NO width/height, and that is the considered choice, not
                         an oversight: those attributes are a claim about the
                         DELIVERED derivative's aspect, and these five frames are
                         not square (400×340, 400×320, …). Declaring 72×72 to
                         match the CSS box states a shape the bytes do not have —
                         rhythm's B2 check caught exactly that, which is the
                         check that exists because two rotation bugs shipped as
                         false aspect claims. The reason CLS is not at stake is
                         that .model-row__thumb pins both dimensions in CSS, so
                         the box is reserved before the bytes arrive; same
                         precedent as the service-area plate sized by
                         .img--full-cover-500. -->
                    <img class="model-row__thumb" src="{{ m.thumb }}" alt=""
                         sizes="72px" loading="lazy" decoding="async">
                    <span class="model-row__designation">{{ m.designation }}</span>
                    <span class="model-row__size">{{ m.size | replace(" x ", " × ") | safe }}</span>
                    <span class="model-row__capacity">{{ m.capacity | replace("-", "–") | safe }}</span>
                    <span class="model-price model-row__price">{{ m.priceDisplay | safe }}</span>
                    <span class="model-row__affordance">Configure</span>
                </div>
{%- endfor %}
            </div>

{% if site.features.advisor %}
            <div class="advisor-container advisor-container--after-index reveal"
                 data-advisor-type="product"
                 data-advisor-placeholder="Describe your space and how you'd use it"
                 data-advisor-multi-turn="true"
                 data-advisor-starters='["I have a 10x12 deck for 4-6 people","Wood-fired vs electric — which is better?","What fits in a small backyard?"]'>
            </div>
{% endif %}
        </section>

