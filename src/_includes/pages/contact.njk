    <div id="contact" class="page page--has-bg">
        <div class="page-bg--fixed page-bg--opacity-30" style="background-image: url('/img/IMG_2819_bl3kb1-1920w.webp');"></div>
        <section class="page-hero">
            <h1>Get Your Quote</h1>
            <p>Tell us about your space and we'll create a custom design plan. No obligation, no pressure.</p>
        </section>

        <section class="container">
{% if site.features.advisor %}
            <div class="advisor-container reveal"
                 data-advisor-type="inquiry"
                 data-advisor-placeholder="Tell us about your project and we'll help you figure out what to ask for"
                 data-advisor-multi-turn="true"
                 data-advisor-starters='["I want a backyard sauna for my family","I\u0027m looking for a commercial installation","Not sure what I need. Help me figure it out"]'>
            </div>
{% endif %}

            {# Endpoint comes from src/_data/site.json (site.forms.endpoint) -- the single
               definition for every form on the site. It used to be written out here AND
               hardcoded as a fallback in js/forms.js; the configurator form would have
               made it three copies. Never paste the literal back in. #}
            <form class="contact-form contact-form--styled" method="POST" action="{{ site.forms.endpoint }}" data-action="contact-submit" data-contact-email="{{ site.email }}">
                <input type="hidden" name="_next" value="https://www.secretsaunacompany.ca/contact/thank-you/">
                <input type="hidden" name="_subject" value="New Sauna Inquiry from Website">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="phone">Phone (optional)</label>
                    <input type="tel" id="phone" name="phone">
                </div>

                <fieldset class="form-fieldset">
                    <legend>Help us understand your project (all optional)</legend>

                    <div class="form-group">
                        <label for="project-type">Project type</label>
                        <select id="project-type" name="project_type">
                            <option value="">Select one</option>
                            <option value="residential">Residential</option>
                            <option value="commercial">Commercial</option>
                            <option value="rental">Rental</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="timeline">Timeline</label>
                        <select id="timeline" name="timeline">
                            <option value="">Select one</option>
                            <option value="this-season">This season</option>
                            <option value="next-season">Next season</option>
                            <option value="exploring">Just exploring</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="budget">Budget range</label>
                        <select id="budget" name="budget">
                            <option value="">Select one</option>
                            <option value="under-25k">Under $25K</option>
                            <option value="25k-40k">$25K - $40K</option>
                            <option value="40k-60k">$40K - $60K</option>
                            <option value="60k-plus">$60K+</option>
                            <option value="not-sure">Not sure yet</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="heat-source">Heat source preference</label>
                        <select id="heat-source" name="heat_source">
                            <option value="">Select one</option>
                            <option value="wood-fired">Wood-fired</option>
                            <option value="electric">Electric</option>
                            <option value="not-sure">Not sure yet</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="capacity">Capacity</label>
                        <select id="capacity" name="capacity">
                            <option value="">Select one</option>
                            <option value="2-3">2-3 people</option>
                            <option value="4-5">4-5 people</option>
                            <option value="6-8">6-8 people</option>
                            <option value="8-plus">8+ people</option>
                            <option value="not-sure">Not sure yet</option>
                        </select>
                    </div>
                </fieldset>

                <div class="form-group">
                    <label for="message">Anything else you'd like us to know? (optional)</label>
                    <textarea id="message" name="message" placeholder="E.g., backyard size, specific features, questions you have..."></textarea>
                </div>

                <button type="submit" class="btn btn--full-width">Get My Quote</button>

                {# Failure surface for js/forms.js showFailure() — same
                   vocabulary as the configurator's #quoteError. aria-live so
                   AT hears the failure without focus theft; hidden until a
                   send actually fails. The old path was a blocking alert()
                   that left no trace and no escape hatch. #}
                <div id="contactError" class="quote-error" hidden aria-live="assertive"></div>

                {# The modal's disclosure sentence VERBATIM (sauna.njk) — this
                   form posts the same PII to the same US endpoint and until
                   2026-08-06 said nothing. Notice-at-collection now matches
                   between the two forms. #}
                <p class="quote-privacy-note">
                    Sent via our US form processor. See our <a href="/privacy/">privacy policy</a>.
                </p>
            </form>

            <div class="contact-info">
                <p class="contact-info__label"><strong>Email</strong></p>
                <p class="contact-info__value"><a href="mailto:secretsaunacompany@gmail.com" class="link--quiet">secretsaunacompany@gmail.com</a></p>

                <p class="contact-info__label"><strong>Based in</strong></p>
                <p>Squamish, British Columbia</p>
            </div>
        </section>
    </div>

    <!-- BOOKING PAGE -->
