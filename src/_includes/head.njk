        "telephone": "",
        "email": "secretsaunacompany@gmail.com",
        "paymentAccepted": ["Cash", "Check", "E-Transfer", "Bank Transfer"],
        "currenciesAccepted": "CAD",
        {# The business location is the Brackendale Art Gallery, where the SC runs
